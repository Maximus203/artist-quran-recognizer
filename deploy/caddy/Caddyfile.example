# Reverse proxy devant l'atelier (exemple, à adapter ; rien n'est appliqué par le dépôt).
# Caddy termine TLS (certificat Let's Encrypt automatique), pose le corps maximal, retire l'en-tête Server
# et transmet l'adresse réelle du visiteur. L'atelier n'écoute que sur 127.0.0.1 : il n'est joignable QUE par ce proxy.
#
# Adresse réelle : l'atelier lit la DERNIÈRE entrée de X-Forwarded-For (AQR_TRUST_PROXY=1). Caddy écrase
# X-Forwarded-For envoyé par un client non fiable, donc cette dernière entrée est celle que Caddy a vue.
# Si un autre proxy (Cloudflare, Authelia) se place devant Caddy, déclarer ses adresses avec `trusted_proxies`.
#
# Limitation de débit : faite par l'atelier lui-même, par famille de route, par adresse et par compte
# (web/lib/http-security.ts, testée dans web/proxy-families.test.ts). Caddy n'en a pas en standard ; ne pas
# ajouter un second limiteur qui ferait compter les mêmes requêtes deux fois.

atelier.exemple.org {
	encode zstd gzip

	# Plafond de la vidéo (AQR_MAX_VIDEO_UPLOAD_BYTES, 2 Gio par défaut) + marge de l'enveloppe multipart.
	# L'atelier applique ses propres limites par route ; ce plafond arrête le reste avant même de le joindre.
	request_body {
		max_size 2100MB
	}

	header {
		-Server
		-X-Powered-By
	}

	# Le service du direct (WebSocket) : même nom d'hôte, chemin dédié, port local du service (8765 par défaut).
	@live path /live /live/*
	handle @live {
		reverse_proxy 127.0.0.1:8765
	}

	handle {
		reverse_proxy 127.0.0.1:3000 {
			# Une analyse ou un export peut durer : pas de coupure côté proxy pendant une réponse en cours.
			transport http {
				response_header_timeout 15m
			}
			health_uri /api/health
			health_interval 30s
		}
	}

	log {
		output file /var/log/caddy/atelier.access.log {
			roll_size 50MiB
			roll_keep 10
		}
		format json
	}
}

# Toute autre adresse (IP nue, nom inconnu) : aucune réponse utile.
:80 {
	redir https://atelier.exemple.org{uri} permanent
}
