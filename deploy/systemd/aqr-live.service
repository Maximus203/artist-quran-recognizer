# Service d'écoute en direct (WebSocket), à côté de l'atelier. Même clé AQR_LIVE_KEY que l'atelier
# (fichier d'environnement /etc/aqr/live.env, mode 0600). Aucun audio n'est écrit sur le disque.
[Unit]
Description=Service d'écoute en direct (aqr live-serve)
After=network-online.target

[Service]
User=aqr
Group=aqr
WorkingDirectory=/opt/aqr/current
EnvironmentFile=/etc/aqr/live.env
ExecStart=/opt/aqr/current/.venv/bin/python -m aqr.cli live-serve --corpus-dir /opt/aqr/current/data/corpus
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aqr/logs
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0027

[Install]
WantedBy=multi-user.target
