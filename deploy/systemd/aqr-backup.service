# Sauvegarde locale cohérente (base + sessions + avatars) puis vérification. Le dossier produit est ensuite
# copié, chiffré, vers deux autres emplacements par restic (règle 3-2-1, docs/INFRASTRUCTURE.md).
[Unit]
Description=Sauvegarde de l'atelier

[Service]
Type=oneshot



ExecStart=/usr/bin/docker exec atelier node scripts/backup.mjs backup --root /data --out /data/backups --keep 14
# Copie hors machine : restic lit /data/backups (volume Docker « atelier-data ») ; dépôt et mot de passe dans /etc/aqr/restic.env.
ExecStartPost=/bin/sh -c '. /etc/aqr/restic.env && restic backup "$(docker volume inspect atelier-data -f {{.Mountpoint}})/backups" --tag atelier && restic forget --keep-daily 14 --keep-weekly 8 --keep-monthly 6 --prune'
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

UMask=0027
