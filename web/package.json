{
  "name": "artist-quran-review",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "start:local": "node scripts/start-local.mjs",
    "typecheck": "tsc --noEmit",
    "smoke:browser": "node e2e/browser-smoke.mjs",
    "check:layout": "node e2e/layout-overflow.mjs",
    "test": "vitest run",
    "format:check": "prettier --check app lib e2e next.config.ts tsconfig.json package.json",
    "format": "prettier --write app lib e2e next.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "next": "^16.4.3",
    "playwright-core": "1.56.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
