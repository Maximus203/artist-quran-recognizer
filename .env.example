# Copier en .env (jamais commité) ou exporter dans l'environnement.
# Chemins locaux, hors dépôt. Aucune clé n'est requise pour le développement actuel.
AQR_AUDIO_DIR=
AQR_MODELS_DIR=
# Jeu de fine-tuning (scripts/build_finetune_manifest.py) : téléchargements, WAV extraits, manifestes.
AQR_FINETUNE_DIR=
# Lots audio privés (scripts/audio_lot.py) : jeton Hugging Face et dataset PRIVÉ « user/nom ».
HF_TOKEN=
AQR_HF_DATASET=printf0cherif/aqr-audio-private
# Manifeste de vérité terrain (défaut : tests/fixtures/audio/manifest.yaml, sinon <AQR_AUDIO_DIR>/manifest.yaml).
AQR_MANIFEST=
# Détection en direct (aqr live-serve, docs/LIVE-PROTOCOL.md) : la clé de signature des jetons est commune
# à l'atelier et au service. Vide = fichier local live-signing.key créé au premier démarrage (hors dépôt).
AQR_LIVE_KEY=
AQR_LIVE_URL=

# Atelier en production (docs/SECRETS-ET-CONFIGURATION.md) : un mode d'accès à déclarer, sinon le serveur refuse de démarrer.
# Poste local : `npm run start:local` (ou AQR_LOCAL_ONLY=1). Accès public : les variables suivantes, toutes obligatoires (32 caractères aléatoires au moins
# pour les secrets). Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
AQR_LOCAL_ONLY=
AQR_ACCESS_TOKEN=
AQR_PUBLIC_ORIGIN=
AQR_TRUST_PROXY=
AQR_SIGNUP=
AQR_SIGNUP_CODE=
AQR_AUDIT_SALT=
AQR_FORM_KEY=

# Arrêt d'urgence au démarrage : restricted ou maintenance (sinon fichier control/ dans le dossier de données, docs/INFRASTRUCTURE.md).
AQR_SERVICE_MODE=
